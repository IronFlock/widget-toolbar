{
    "name": "@ironflock/widget-toolbar",
    "description": "IronFlock board widget: a responsive toolbar of buttons, switches, sliders and choices that write table columns and set URL parameters",
    "license": "MIT",
    "author": "IronFlock GmbH",
    "version": "1.0.2",
    "engines": {
        "node": ">=24.9.0",
        "npm": ">=10.0.2"
    },
    "type": "module",
    "main": "dist/widget-toolbar.js",
    "files": [
        "dist",
        "src",
        "thumbnail.png",
        "thumbnail.webp"
    ],
    "scripts": {
        "start": "vite build --watch & vite",
        "build": "tsc -p . && vite build",
        "watch": "vite build --watch",
        "typecheck": "tsc -p .",
        "test": "node --test 'test/*.test.mjs'",
        "types": "cat src/definition-schema.json | json2ts --style.tabWidth=4 > src/definition-schema.d.ts"
    },
    "dependencies": {
        "lit": "^3.3.3"
    },
    "peerDependencies": {
        "@material/web": "^2.4.1"
    },
    "devDependencies": {
        "@material/web": "2.4.1",
        "@rollup/plugin-replace": "^6.0.2",
        "json-schema-to-typescript": "^15.0.4",
        "tslib": "^2.8.1",
        "typescript": "^5.9.3",
        "vite": "^7.3.0"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/IronFlock/widget-toolbar.git"
    },
    "keywords": [
        "ironflock",
        "widget",
        "toolbar"
    ],
    "bugs": {
        "url": "https://github.com/IronFlock/widget-toolbar/issues"
    },
    "homepage": "https://github.com/IronFlock/widget-toolbar#readme"
}
